# MiMo Free API MCP - 环境配置文件示例
# 复制此文件为 .env 并填写您的凭证

# [必填] 小米 Mimo 凭证 (格式: ph.uid.token 或 抓包获取的长字符串)
token=your_mimo_token_here
# [可选] 服务绑定端口 (默认 8001)
SERVER_PORT=8001

# [可选] MCP search 工具使用的模型 (默认 mimo-v2.5-pro,可改为 mimo-v2.6-pro 等)
#MCP_SEARCH_MODEL=mimo-v2.5-pro
# [可选] MCP vision 工具使用的模型 (默认 mimo-v2.5,可改为 mimo-v2.6-pro 等)
#MCP_VISION_MODEL=mimo-v2.5
